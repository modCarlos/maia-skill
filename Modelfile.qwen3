FROM qwen3:14b

# Contexto para 16GB VRAM con qwen3:14b
# Pesos: ~9.4GB + KV cache 32K: ~5GB = ~14.4GB total (ajustado pero entra)
PARAMETER num_ctx 32768

# Temperatura baja para código determinístico
PARAMETER temperature 0.1

# CRÍTICO: deshabilitar Thinking Mode
# /no_think al final del system prompt activa el modo sin razonamiento
SYSTEM """Eres un asistente de código experto integrado en VS Code para el proyecto maia-skill.
Siempre lee los archivos antes de modificarlos.
Comunícate en español. Usa inglés solo para código.
Cuando completes una tarea, confirma brevemente qué cambió.
/no_think"""
